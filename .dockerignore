# Patterns to exclude from the Docker build context
# Keeps the image lean and prevents sensitive files leaking into the build

# Version control
.git/
.gitignore

# Python cache and build artifacts
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / coverage output (not needed in image — run at test time)
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter checkpoints
.ipynb_checkpoints/
notebooks/output/

# Environment secrets — never bake .env into image
.env

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Large data files (mount at runtime via -v flag instead)
# data/qa/ is allowed through — small golden fixtures required by test suite
# data/validation/ — vendored SOA Illustrative Life Table for the validation pack tests
# data/inputs/portfolio_sample/ — small fixture for the dashboard portfolio loader tests
# data/inputs/portfolio_staggered_sample/ — calendar-mode (ADR-061) fixture for the same tests
data/*
!data/qa/
!data/qa/**
!data/validation/
!data/validation/**
!data/inputs/
data/inputs/*
!data/inputs/portfolio_sample/
!data/inputs/portfolio_sample/**
!data/inputs/portfolio_staggered_sample/
!data/inputs/portfolio_staggered_sample/**
*.parquet
*.csv

# CI/CD — not needed inside the container, EXCEPT the workflows dir, which
# tests/test_ci/ parses (perf-harness Slice 3, ADR-176) and the runtime image
# runs the test suite. Mirrors the data/qa/ allowlist pattern above.
.github/
!.github/workflows/
!.github/workflows/**

# Documentation source (not needed at runtime) — EXCEPT docs/measurements/,
# which tests/test_notebooks/test_experience_gam_diligence_notebook.py reads
# (the notebook re-derives every claim in the MEASUREMENT docs from those
# committed reports, so executing it is the check on the prose). The runtime
# image runs the test suite, so they must be present. Mirrors the data/qa/ and
# .github/workflows/ allowlists above.
#
# The attribution documents ride along for the same reason and one more: an image
# that carries somebody else's findings should carry the credit for them.
# tests/test_docs/test_data_attribution.py asserts they do.
docs/*
!docs/measurements/
!docs/measurements/**
!docs/DATA_LICENSING.md
!docs/MEASUREMENT_experience_gam_hmd.md
!docs/MEASUREMENT_experience_gam_ilec.md
