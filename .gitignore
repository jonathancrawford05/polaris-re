# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# uv
.venv/
# uv.lock IS committed — required for reproducible CI installs and GitHub Actions caching.

# Legacy venv / pip
venv/
env/
*.egg-info/
.eggs/
dist/
build/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Type checking
.mypy_cache/

# Linting
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints
notebooks/output/
!notebooks/output/.gitkeep

# Environment variables (never commit secrets)
.env
!.env.example

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# Data files (actuarial tables, large CSVs) — do not commit
# We exclude specific sub-paths rather than all of data/, so that new
# files in data/inputs/, data/configs/, and data/qa/ can be committed
# without requiring `git add -f` (git will not re-include files whose
# parent directory is excluded).
data/mortality_tables/
data/outputs/
data/normalised_block.csv
*.parquet

# Logs
*.log
logs/

# Docker
*.tar

# Performance harness (scripts/perfbench.py) artifacts
# The transient head-vs-main worktree is removed in a finally + pre-cleared on
# each run, but a hard-kill mid-run could leave it; ignore so it never gets
# committed. perf.json is the runner's default machine-readable output.
# perf/history.jsonl (the committed per-merge log) is NOT ignored — it is the
# durable series scripts/perf_history.py appends to; perf_history.json is its
# transient creep-verdict output, ignored like perf.json.
.perfbench_main_worktree/
perf.json
perf_history.json
